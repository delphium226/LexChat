# Native Environment Configuration
# These settings override config.py defaults using Pydantic Settings

# Core Server Settings
# (Port 8080 is defined in the start script, but keeping these defaults standard)
PORT=8080
HOST=0.0.0.0

# Database
# Native PostgreSQL runs on localhost:5432
DATABASE_URL=postgresql://lexuser:lexpassword@localhost:5432/lexchat

# Agent / Ollama
# Native Ollama runs on localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# LEX API
LEX_API_URL=https://lex.lab.i.ai.gov.uk/

# Security
# Change this for production!
JWT_SECRET=production_secret_key_change_me

# Backup / scoped restore (D14)
# BACKUP_ROOT must match the -BackupRoot that deployment/backup_databases.ps1 and
# deployment/install_backup_task.ps1 write to, or the Developer tab's backup panel
# reads an empty directory and the scoped restore has nothing to offer.
BACKUP_ROOT=C:\LexChatBackups
# PG_BIN is auto-detected from C:\Program Files\PostgreSQL\* (highest version wins);
# set it only if pg_restore.exe / pg_dump.exe live somewhere else.
# PG_BIN=C:\Program Files\PostgreSQL\18\bin
