# Native Environment Configuration
# These settings override config.py defaults using Pydantic Settings

# Core Server Settings
# (Port 8080 is defined in the start script, but keeping these defaults standard)
PORT=8080
HOST=0.0.0.0

# Database
# Native PostgreSQL runs on localhost:5432
DATABASE_URL=postgresql://postgres:lexpassword@localhost:5432/lexchat

# Agent / Ollama
# Native Ollama runs on localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# LEX API
LEX_API_URL=https://lex.lab.i.ai.gov.uk/

# Security
# Change this for production!
JWT_SECRET=production_secret_key_change_me
