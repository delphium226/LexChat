BOT_ID=drafting_bot
BOT_CONFIG_PATH=bots/drafting/bot_config.json
PORT=8003
DATABASE_URL=postgresql://lexuser:lexpassword@localhost:5432/lexchat_drafting
# This is the value that actually selects the mode everywhere — `agent.research_mode`
# in bot_config.json is decorative and nothing reads it. Setting it here makes
# resolve_research_mode() (routers/agent_request.py) force every request into
# drafting mode regardless of what the client sends.
RESEARCH_MODE=drafting
